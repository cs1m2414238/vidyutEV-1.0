# Use your computer's LAN IP when testing on a physical device.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080/api

# Keep false when validating PostgreSQL-backed flows.
EXPO_PUBLIC_USE_MOCK_DATA=false

# Create Web, Android and iOS OAuth clients in Google Cloud. Never put a client secret in the app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
